@page "/bookings"
@layout MainLayout
@attribute [Authorize(Roles = ("Admin"))]
@using GedBooking.Shared.DTOs
@using Microsoft.AspNetCore.Authorization
@inject IBookingService BookingService
@inject NavigationManager NavManager
@inject IJSRuntime JS


<PageTitle>GED Exam Bookings</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">Exam Bookings Management</h3>
        <small class="text-muted">Manage student GED exam schedules and approval status</small>
    </div>
    <button class="btn btn-primary" @onclick="GoToCreatePage">
        + New Exam Booking
    </button>
</div>

@if (isLoading)
{
    <div class="text-center my-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2 text-muted">Loading bookings from API...</p>
    </div>
}
else if (!bookings.Any())
{
    <div class="alert alert-info">No exam bookings found.</div>
}
else
{
    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-light">
                <div class="card-body">
                    <h6 class="text-muted">Total Bookings</h6>
                    <h3 class="fw-bold">@bookings.Count</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-light">
                <div class="card-body">
                    <h6 class="text-muted">Pending Approval</h6>
                    <h3 class="fw-bold text-warning">@bookings.Count(b => b.Status == "Pending")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-light">
                <div class="card-body">
                    <h6 class="text-muted">Approved Exams</h6>
                    <h3 class="fw-bold text-success">@bookings.Count(b => b.Status == "Approved")</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Search and Filter Section -->
    <div class="row mb-3 align-items-center">
        <div class="col-md-6">
            <!--@bind:event="oninput" သည် စာရိုက်နေစဉ် ချက်ချင်း Real-time အလုပ်လုပ်စေပါသည် -->
            <input type="text" class="form-control" placeholder="🔍 Search by student name or subject..."
                   @bind="SearchText" @bind:event="oninput" />
        </div>
        <div class="col-md-6 text-end">
            <!-- Child Component ကို ခေါ်သုံးခြင်း -->
            <StatusFilter CurrentStatus="@currentStatus" OnStatusChanged="HandleStatusChange" />
        </div>
    </div>

    <!-- Bookings Data Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">ID</th>
                        <th>Student Name</th>
                        <th>Subject</th>
                        <th>Exam Date</th>
                        <th>Fee</th>
                        <th>Status</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in filteredBookings)
                    {
                        <tr>
                            <td class="ps-3 fw-semibold">#@item.Id</td>
                            <td>
                                <div>@item.StudentName</div>
                                <small class="text-muted">@item.Email</small>
                            </td>
                            <td>@item.Subject</td>
                            <td>@item.ExamDate.ToString("dd MMM yyyy")</td>
                            <td>$@item.ExamFee</td>
                            <td>
                                <span class="badge @GetStatusBadgeClass(item.Status)">
                                    @item.Status
                                </span>
                            </td>
                            <td class="text-end pe-3">
                                <button class="btn btn-sm btn-outline-secondary me-1"
                                        @onclick="() => GoToEditPage(item.Id)">
                                    Edit
                                </button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteBooking(item.Id)">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<ExamBookingDto> bookings = new();
    private List<ExamBookingDto> filteredBookings = new(); // UI တွင် ပြသမည့် List
    private bool isLoading = true;

    // Filter သိမ်းဆည်းရန် Variables
    private string currentStatus = "All";
    private string _searchText = "";

    // C# Property ကိုသုံး၍ စာရိုက်တိုင်း FilterData() ကို အလိုအလျောက် ခေါ်ပေးခြင်း
    private string SearchText
    {
        get => _searchText;
        set
        {
            _searchText = value;
            FilterData();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        bookings = await BookingService.GetBookingsAsync();
        filteredBookings = bookings; // အစပိုင်းတွင် အကုန်ပြရန်
        isLoading = false;
    }

    // StatusFilter Component မှ Event လှမ်းပို့လျှင် အလုပ်လုပ်မည့် Method
    private void HandleStatusChange(string status)
    {
        currentStatus = status;
        FilterData();
    }

    // Logic: Status နှင့် Search တွဲ၍ စစ်ထုတ်ခြင်း
    private void FilterData()
    {
        filteredBookings = bookings.Where(b =>
            (currentStatus == "All" || b.Status == currentStatus) &&
            (string.IsNullOrWhiteSpace(SearchText) ||
             b.StudentName.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ||
             b.Subject.Contains(SearchText, StringComparison.OrdinalIgnoreCase))
        ).ToList();
    }

    private void GoToCreatePage() => NavManager.NavigateTo("/bookings/create");
    private void GoToEditPage(int id) => NavManager.NavigateTo($"/bookings/edit/{id}");

    private string GetStatusBadgeClass(string status) => status switch
    {
        "Approved" => "bg-success",
        "Pending" => "bg-warning text-dark",
        "Rejected" => "bg-danger",
        _ => "bg-secondary"
    };

    private async Task DeleteBooking(int id)
    {
        bool isConfirmed = await JS.InvokeAsync<bool>("showDeleteConfirm", "This booking data will be permanently removed!");

        // 2. User က Yes နှိပ်မှသာ API သို့ Delete Request ပို့မည်
        if (isConfirmed)
        {
            var success = await BookingService.DeleteBookingAsync(id);
            if (success)
            {
                await JS.InvokeVoidAsync("showToast", "Booking deleted successfully!", "success");
                await OnInitializedAsync();
            }
        }
    }
}