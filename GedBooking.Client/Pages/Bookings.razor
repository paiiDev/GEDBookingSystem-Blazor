@page "/bookings"
@using GedBooking.Shared.DTOs
@inject IBookingService BookingService
@inject NavigationManager NavManager

<PageTitle>GED Exam Bookings</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">Exam Bookings Management</h3>
        <small class="text-muted">Manage student GED exam schedules and approval status</small>
    </div>
    <button class="btn btn-primary" @onclick="GoToCreatePage">
        + New Exam Booking
    </button>
</div>

@if (isLoading)
{
    <div class="text-center my-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2 text-muted">Loading bookings from API...</p>
    </div>
}
else if (!bookings.Any())
{
    <div class="alert alert-info">No exam bookings found.</div>
}
else
{
    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-light">
                <div class="card-body">
                    <h6 class="text-muted">Total Bookings</h6>
                    <h3 class="fw-bold">@bookings.Count</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-light">
                <div class="card-body">
                    <h6 class="text-muted">Pending Approval</h6>
                    <h3 class="fw-bold text-warning">@bookings.Count(b => b.Status == "Pending")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-light">
                <div class="card-body">
                    <h6 class="text-muted">Approved Exams</h6>
                    <h3 class="fw-bold text-success">@bookings.Count(b => b.Status == "Approved")</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Bookings Data Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">ID</th>
                        <th>Student Name</th>
                        <th>Subject</th>
                        <th>Exam Date</th>
                        <th>Fee</th>
                        <th>Status</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in bookings)
                    {
                        <tr>
                            <td class="ps-3 fw-semibold">#@item.Id</td>
                            <td>
                                <div>@item.StudentName</div>
                                <small class="text-muted">@item.Email</small>
                            </td>
                            <td>@item.Subject</td>
                            <td>@item.ExamDate.ToString("dd MMM yyyy")</td>
                            <td>$@item.ExamFee</td>
                            <td>
                                <span class="badge @GetStatusBadgeClass(item.Status)">
                                    @item.Status
                                </span>
                            </td>
                            <td class="text-end pe-3">
                                <button class="btn btn-sm btn-outline-secondary me-1"
                                        @onclick="() => GoToEditPage(item.Id)">
                                    Edit
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<ExamBookingDto> bookings = new();
    private bool isLoading = true;

    // Component စတင်ပွင့်လာချိန်တွင် API မှ Data ဆွဲထုတ်ခြင်း
    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        bookings = await BookingService.GetBookingsAsync();
        isLoading = false;
    }

    // NavigationManager သုံးပြီး Page ကူးပြောင်းခြင်း
    private void GoToCreatePage() => NavManager.NavigateTo("/bookings/create");
    private void GoToEditPage(int id) => NavManager.NavigateTo($"/bookings/edit/{id}");

    // Status အလိုက် Badge အရောင်ခွဲခြားပေးသော Helper Method
    private string GetStatusBadgeClass(string status) => status switch
    {
        "Approved" => "bg-success",
        "Pending" => "bg-warning text-dark",
        "Rejected" => "bg-danger",
        _ => "bg-secondary"
    };
}